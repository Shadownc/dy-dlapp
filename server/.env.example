# 开发阶段：仅监听本机；微信登录用固定测试用户。正式上线必须关闭。
HOST=127.0.0.1
PORT=8000
DEV_LOGIN=true
WX_APPID=
WX_SECRET=

# 现有解析 API：默认 POST JSON {"url":"..."}；也支持 GET ?url=...
PARSER_API_URL=
PARSER_API_METHOD=POST
PARSER_API_KEY=
PARSER_AUTH_HEADER=Authorization
PARSER_AUTH_PREFIX=Bearer 

# 后台初始账号固定为 admin；用 python -m server.hash_password 生成摘要
ADMIN_PASSWORD_HASH=
COOKIE_SECURE=false

# 生产环境填写随机长字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"
MEDIA_SIGNING_KEY=
MEDIA_ALLOWED_HOSTS=douyinpic.com,douyinvod.com,zjcdn.com
MEDIA_TOKEN_TTL=1200
MAX_IMAGE_BYTES=20971520
MAX_VIDEO_BYTES=125829120
DATA_DIR=server/data
